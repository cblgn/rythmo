{
  "name": "Protect main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {"ref_name": {"include": ["refs/heads/main"], "exclude": []}},
  "rules": [
    {"type": "deletion"},
    {"type": "non_fast_forward"},
    {"type": "required_linear_history"},
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "required_status_checks": [
          {"context": "Android and JVM", "integration_id": 15368},
          {"context": "Secrets and workflow checks", "integration_id": 15368},
          {"context": "Resolve dependencies", "integration_id": 15368},
          {"context": "Dependency vulnerability audit", "integration_id": 15368},
          {"context": "Dependency review", "integration_id": 15368},
          {"context": "CodeQL (java-kotlin)", "integration_id": 15368},
          {"context": "CodeQL (javascript-typescript)", "integration_id": 15368},
          {"context": "CodeQL (python)", "integration_id": 15368},
          {"context": "CodeQL (actions)", "integration_id": 15368}
        ],
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false
      }
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {"tool": "CodeQL", "alerts_threshold": "all", "security_alerts_threshold": "all"}
        ]
      }
    }
  ]
}
